{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Juris: run and open in browser",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "- Local:\s+(https?://\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Juris: run",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    }
  ]
}
