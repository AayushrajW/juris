# Copy to .env.local to change a setting. Every value here is public: it is
# built into the pages sent to the browser, so never put a secret in this file.

# Shows the "Demo - sample data only" banner on every page.
# Keep true until a real backend stores people's data.
NEXT_PUBLIC_DEMO_MODE=true

# Advocate listings and the advocate chat.
# Keep false. The current screens rank, rate and price advocates, which
# conflicts with Bar Council of India rules. See docs/LAUNCH_PLAN.md, decision 1.
NEXT_PUBLIC_FEATURE_ADVOCATES=false
